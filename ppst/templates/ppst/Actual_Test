<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>CogniFlow - Assessment</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: Arial, Helvetica, sans-serif;
            background: #f5f5f5;
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 20px;
        }

        .test-container {
            background: white;
            border: 1px solid #d1d1d1;
            max-width: 800px;
            width: 100%;
            padding: 40px;
            text-align: center;
        }

        .progress-bar {
            background: #e0e0e0;
            height: 8px;
            border-radius: 4px;
            margin-bottom: 30px;
            overflow: hidden;
        }

        .progress-fill {
            background: #003d7a;
            height: 100%;
            width: 0%;
            transition: width 0.3s ease;
        }

        .trial-info {
            color: #666;
            font-size: 0.9rem;
            margin-bottom: 20px;
        }

        .trial-info strong {
            color: #003d7a;
        }

        .status-message {
            font-size: 1.1rem;
            color: #333;
            margin-bottom: 30px;
            min-height: 30px;
        }

        /* Stimulus Display Area */
        .stimulus-display {
            background: #f9f9f9;
            border: 2px solid #003d7a;
            padding: 60px 40px;
            margin: 30px 0;
            border-radius: 3px;
            min-height: 200px;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .stimulus-sequence {
            font-size: 3rem;
            font-weight: 600;
            color: #003d7a;
            letter-spacing: 20px;
            display: none;
        }

        .stimulus-sequence.active {
            display: block;
        }

        /* Response Buttons */
        .response-grid {
            display: grid;
            grid-template-columns: repeat(5, 1fr);
            gap: 15px;
            margin: 30px 0;
            display: none;
        }

        .response-grid.active {
            display: grid;
        }

        .response-button {
            padding: 25px;
            font-size: 1.5rem;
            font-weight: 600;
            background: white;
            border: 2px solid #003d7a;
            color: #003d7a;
            border-radius: 3px;
            cursor: pointer;
            transition: all 0.2s;
            font-family: Arial, Helvetica, sans-serif;
        }

        .response-button:hover {
            background: #e6f2ff;
        }

        .response-button:active {
            transform: scale(0.95);
        }

        .response-button.selected {
            background: #003d7a;
            color: white;
        }

        .response-button:disabled {
            opacity: 0.5;
            cursor: not-allowed;
        }

        /* User Response Display */
        .user-response {
            font-size: 1.2rem;
            color: #333;
            margin: 20px 0;
            min-height: 40px;
        }

        .user-response strong {
            color: #003d7a;
        }

        /* Action Buttons */
        .action-button {
            padding: 12px 30px;
            font-size: 1rem;
            font-weight: 600;
            background: #003d7a;
            color: white;
            border: none;
            border-radius: 3px;
            cursor: pointer;
            font-family: Arial, Helvetica, sans-serif;
            margin: 10px 5px;
            display: none;
        }

        .action-button.active {
            display: inline-block;
        }

        .action-button:hover {
            background: #002d5a;
        }

        /* Completion Screen */
        .completion-screen {
            display: none;
            padding: 40px 20px;
        }

        .completion-screen.active {
            display: block;
        }

        .completion-screen h2 {
            color: #003d7a;
            font-size: 1.5rem;
            margin-bottom: 20px;
        }

        .completion-screen p {
            color: #555;
            font-size: 1rem;
            line-height: 1.7;
            margin-bottom: 15px;
        }

        .completion-icon {
            font-size: 4rem;
            color: #28a745;
            margin-bottom: 20px;
        }

        /* Responsive Design */
        @media (max-width: 768px) {
            .test-container {
                padding: 30px 20px;
            }

            .stimulus-sequence {
                font-size: 2rem;
                letter-spacing: 15px;
            }

            .response-grid {
                grid-template-columns: repeat(3, 1fr);
                gap: 10px;
            }

            .response-button {
                padding: 20px;
                font-size: 1.3rem;
            }
        }

        @media (max-width: 480px) {
            .response-grid {
                grid-template-columns: repeat(2, 1fr);
            }

            .stimulus-sequence {
                font-size: 1.5rem;
                letter-spacing: 10px;
            }
        }
    </style>
</head>
<body>
    <div class="test-container">
        <!-- Test Interface -->
        <div id="test-interface">
            <!-- Progress Bar -->
            <div class="progress-bar">
                <div class="progress-fill" id="progress"></div>
            </div>

            <!-- Trial Information -->
            <div class="trial-info">
                <span id="trial-counter">Trial <strong id="current-trial">1</strong> of <strong id="total-trials">12</strong></span>
            </div>

            <!-- Status Message -->
            <div class="status-message" id="status-message">
                <span id="status-text">Get ready...</span>
            </div>

            <!-- Stimulus Display -->
            <div class="stimulus-display">
                <div class="stimulus-sequence" id="stimulus"></div>
            </div>

            <!-- User Response Display -->
            <div class="user-response" id="user-response"></div>

            <!-- Response Grid -->
            <div class="response-grid" id="response-grid">
                <!-- Buttons will be dynamically generated -->
            </div>

            <!-- Action Buttons -->
            <button class="action-button" id="submit-btn">Submit Response</button>
            <button class="action-button" id="next-btn">Next Trial</button>
        </div>

        <!-- Completion Screen -->
        <div class="completion-screen" id="completion-screen">
            <div class="completion-icon">✓</div>
            <h2 id="completion-title">Assessment Complete</h2>
            <p id="completion-message">Thank you for completing the Philadelphia Pointing Span Test.</p>
            <p id="completion-info">Your responses have been recorded. You may now close this window.</p>
        </div>
    </div>

    <script>
        // Get language from URL
        const urlParams = new URLSearchParams(window.location.search);
        const language = urlParams.get('lang') || 'en';

        // Actual test trials (12 trials: 6 digit-only, 6 mixed)
        const testTrials = [
            // Digit-only trials (6)
            { sequence: ['2', '9', '5'], type: 'digit' },
            { sequence: ['7', '3', '1', '8'], type: 'digit' },
            { sequence: ['4', '1', '9', '6', '2'], type: 'digit' },
            { sequence: ['5', '8', '2', '7', '3', '1'], type: 'digit' },
            { sequence: ['9', '4', '6', '1', '8', '3', '5'], type: 'digit' },
            { sequence: ['3', '7', '2', '9', '1', '5', '4', '8'], type: 'digit' },
            
            // Mixed digit-letter trials (6)
            { sequence: ['A', '3', 'K'], type: 'mixed' },
            { sequence: ['5', 'R', '2', 'B'], type: 'mixed' },
            { sequence: ['T', '7', 'D', '4', 'N'], type: 'mixed' },
            { sequence: ['9', 'L', '3', 'F', '6', 'H'], type: 'mixed' },
            { sequence: ['M', '2', 'S', '8', 'C', '5', 'K'], type: 'mixed' },
            { sequence: ['4', 'R', '1', 'E', '7', 'A', '9', 'T'], type: 'mixed' }
        ];

        // Available symbols for responses
        const digitSymbols = ['1', '2', '3', '4', '5', '6', '7', '8', '9'];
        const letterSymbols = ['A', 'B', 'C', 'D', 'E', 'F', 'G', 'H', 'K', 'L', 'M', 'N', 'R', 'S', 'T'];

        // Test state
        let currentTrialIndex = 0;
        let userResponse = [];
        let startTime = null;
        let testResults = [];

        // Translations
        const translations = {
            en: {
                trialCounter: "Trial",
                of: "of",
                getReady: "Get ready...",
                watchAndListen: "Watch and listen carefully...",
                nowRespond: "Now click the symbols in order:",
                yourResponse: "Your response:",
                submit: "Submit Response",
                nextTrial: "Next Trial",
                completionTitle: "Assessment Complete",
                completionMessage: "Thank you for completing the Philadelphia Pointing Span Test.",
                completionInfo: "Your responses have been recorded. You may now close this window."
            },
            es: {
                trialCounter: "Prueba",
                of: "de",
                getReady: "Prepárese...",
                watchAndListen: "Observe y escuche con atención...",
                nowRespond: "Ahora haga clic en los símbolos en orden:",
                yourResponse: "Su respuesta:",
                submit: "Enviar Respuesta",
                nextTrial: "Siguiente Prueba",
                completionTitle: "Evaluación Completa",
                completionMessage: "Gracias por completar la Prueba de Amplitud de Señalamiento de Filadelfia.",
                completionInfo: "Sus respuestas han sido registradas. Ahora puede cerrar esta ventana."
            }
        };

        const t = translations[language];

        // Update text elements
        document.getElementById('trial-counter').innerHTML = `${t.trialCounter} <strong id="current-trial">1</strong> ${t.of} <strong id="total-trials">12</strong>`;
        document.getElementById('submit-btn').textContent = t.submit;
        document.getElementById('next-btn').textContent = t.nextTrial;
        document.getElementById('completion-title').textContent = t.completionTitle;
        document.getElementById('completion-message').textContent = t.completionMessage;
        document.getElementById('completion-info').textContent = t.completionInfo;

        // Initialize test
        function initTest() {
            setTimeout(() => {
                startTrial();
            }, 1500);
        }

        // Start a trial
        function startTrial() {
            const trial = testTrials[currentTrialIndex];
            userResponse = [];
            
            // Update progress
            const progress = ((currentTrialIndex + 1) / testTrials.length) * 100;
            document.getElementById('progress').style.width = progress + '%';
            
            // Update trial counter
            document.getElementById('current-trial').textContent = currentTrialIndex + 1;
            
            // Reset display
            document.getElementById('status-text').textContent = t.watchAndListen;
            document.getElementById('stimulus').classList.remove('active');
            document.getElementById('response-grid').classList.remove('active');
            document.getElementById('user-response').textContent = '';
            hideAllButtons();
            
            // Show stimulus after delay
            setTimeout(() => {
                showStimulus(trial.sequence);
            }, 1000);
        }

        // Show stimulus
        function showStimulus(sequence) {
            const stimulusEl = document.getElementById('stimulus');
            stimulusEl.textContent = sequence.join(' - ');
            stimulusEl.classList.add('active');
            
            // Play audio for each symbol in sequence
            playAudioSequence(sequence);
            
            // Hide stimulus and show response grid
            setTimeout(() => {
                stimulusEl.classList.remove('active');
                showResponseGrid(testTrials[currentTrialIndex].type);
            }, sequence.length * 1000 + 1000);
        }

        // Play audio sequence using Web Speech API
        function playAudioSequence(sequence) {
            if ('speechSynthesis' in window) {
                sequence.forEach((symbol, index) => {
                    setTimeout(() => {
                        const utterance = new SpeechSynthesisUtterance(symbol);
                        utterance.lang = language === 'es' ? 'es-ES' : 'en-US';
                        utterance.rate = 0.8; // Slightly slower for clarity
                        speechSynthesis.speak(utterance);
                    }, index * 1000);
                });
            }
        }

        // Show response grid
        function showResponseGrid(type) {
            document.getElementById('status-text').textContent = t.nowRespond;
            
            let symbols;
            if (type === 'digit') {
                symbols = digitSymbols;
            } else { // mixed
                symbols = [...digitSymbols, ...letterSymbols].sort();
            }
            
            const grid = document.getElementById('response-grid');
            grid.innerHTML = '';
            
            symbols.forEach(symbol => {
                const button = document.createElement('button');
                button.className = 'response-button';
                button.textContent = symbol;
                button.onclick = () => selectSymbol(symbol, button);
                grid.appendChild(button);
            });
            
            grid.classList.add('active');
            document.getElementById('submit-btn').classList.add('active');
            
            // Start timing
            startTime = Date.now();
        }

        // Select symbol
        function selectSymbol(symbol, button) {
            userResponse.push(symbol);
            button.classList.add('selected');
            button.disabled = true;
            
            // Auditory feedback - speak the selected symbol
            if ('speechSynthesis' in window) {
                const utterance = new SpeechSynthesisUtterance(symbol);
                utterance.lang = language === 'es' ? 'es-ES' : 'en-US';
                utterance.rate = 0.9;
                speechSynthesis.speak(utterance);
            }
            
            // Update display
            document.getElementById('user-response').innerHTML = 
                `<strong>${t.yourResponse}</strong> ${userResponse.join(' - ')}`;
        }

        // Submit response
        document.getElementById('submit-btn').onclick = function() {
            if (userResponse.length === 0) return;
            
            const responseTime = Date.now() - startTime;
            
            // Record trial result
            const trial = testTrials[currentTrialIndex];
            const isCorrect = JSON.stringify(userResponse) === JSON.stringify(trial.sequence);
            
            testResults.push({
                trialNumber: currentTrialIndex + 1,
                type: trial.type,
                stimulus: trial.sequence,
                response: userResponse,
                correct: isCorrect,
                responseTime: responseTime
            });
            
            // Disable all buttons
            const buttons = document.querySelectorAll('.response-button');
            buttons.forEach(btn => btn.disabled = true);
            
            this.classList.remove('active');
            
            // Show next button or finish
            if (currentTrialIndex < testTrials.length - 1) {
                document.getElementById('next-btn').classList.add('active');
            } else {
                finishTest();
            }
        };

        // Next trial
        document.getElementById('next-btn').onclick = function() {
            currentTrialIndex++;
            this.classList.remove('active');
            startTrial();
        };

        // Finish test
        function finishTest() {
            // Hide test interface
            document.getElementById('test-interface').style.display = 'none';
            
            // Show completion screen
            document.getElementById('completion-screen').classList.add('active');
            
            // Send results to server
            sendResults();
        }

        // Send results to server
        function sendResults() {
            // In real implementation, would POST to backend
            console.log('Test Results:', testResults);
            
            // Calculate summary statistics
            const correctCount = testResults.filter(r => r.correct).length;
            const accuracy = (correctCount / testResults.length * 100).toFixed(1);
            const avgResponseTime = (testResults.reduce((sum, r) => sum + r.responseTime, 0) / testResults.length).toFixed(0);
            
            console.log(`Accuracy: ${accuracy}%`);
            console.log(`Average Response Time: ${avgResponseTime}ms`);
            
            // POST to backend (example)
            /*
            fetch('/api/submit-results', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                },
                body: JSON.stringify({
                    results: testResults,
                    language: language,
                    completedAt: new Date().toISOString()
                })
            });
            */
        }

        // Helper functions
        function hideAllButtons() {
            document.getElementById('submit-btn').classList.remove('active');
            document.getElementById('next-btn').classList.remove('active');
        }

        // Start the test
        initTest();
    </script>
</body>
</html>
